{
  "name": "weddingwebsite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "postbuild": "node scripts/prune-local-media.js && node scripts/generate-sitemap.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "npm run lint:fix && npm run format",
    "preview": "vite preview",
    "media:upload": "node scripts/upload-remote-media.js",
    "inspect:guestbook": "node scripts/inspect_guestbook.cjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test tests/e2e/home.spec.ts tests/e2e/film.spec.ts tests/e2e/gallery.spec.ts tests/e2e/upload.spec.ts tests/e2e/guestbook.spec.ts tests/e2e/a11y.spec.ts tests/e2e/shell.spec.ts tests/e2e/smoke.spec.ts tests/e2e/seo.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:visual": "playwright test",
    "verify:env": "node scripts/verify-release-env.js",
    "verify:launch": "npm run verify:release && node scripts/verify-launch-readiness.js",
    "verify:deployed": "node scripts/verify-deployed-site.js",
    "verify:secrets": "node scripts/verify-repo-secrets.js",
    "verify:supabase": "node scripts/verify_supabase.js",
    "verify:release": "npm run verify:env && npm run verify:secrets && npm run verify:supabase && npm run lint && npx tsc --noEmit && npm run test:run && npm run build && npm run test:e2e:public",
    "deps:update": "node scripts/update-dependencies.js",
    "deps:check": "npm outdated && npm audit",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix --legacy-peer-deps"
  },
  "dependencies": {
    "@fontsource/allura": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/pinyon-script": "^5.2.8",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-tooltip": "1.2.8",
    "@sentry/browser": "10.42.0",
    "@sentry/react": "10.42.0",
    "@supabase/supabase-js": "^2.99.0",
    "@tailwindcss/vite": "^4.2.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "^3.3.1",
    "framer-motion": "12.35.2",
    "leaflet": "^1.9.4",
    "lenis": "1.3.18",
    "lucide-react": "0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "react-masonry-css": "^1.0.16",
    "react-router-dom": "7.13.1",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "^4.1.18",
    "web-vitals": "^5.1.0",
    "zod": "4.3.6",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/leaflet": "^1.9.21",
    "@types/node": "25.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "csso": "^5.0.5",
    "dotenv": "17.3.1",
    "eslint": "10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "husky": "^9.1.7",
    "jsdom": "28.1.0",
    "lint-staged": "16.3.2",
    "prettier": "3.8.1",
    "rollup-plugin-visualizer": "7.0.1",
    "serve": "14.2.6",
    "sharp": "^0.34.5",
    "sitemap": "9.0.1",
    "supabase": "2.77.1",
    "terser": "5.46.0",
    "tus-js-client": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "wait-on": "9.0.4"
  }
}
