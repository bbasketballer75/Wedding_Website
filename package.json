{
  "name": "weddingwebsite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "build:analyze": "node scripts/build-analyze.js",
    "postbuild": "node scripts/prune-local-media.js && node scripts/copy-public-images.js && node scripts/generate-sitemap.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "npm run lint:fix && npm run format",
    "preview": "vite preview",
    "supabase": "npx supabase",
    "supabase:link": "npx supabase link --project-ref rxzbbtghnrvzubqrbhhx",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "supabase:migrations": "npx supabase migration list",
    "supabase:db:push": "npx supabase db push",
    "supabase:db:push:dry": "npx supabase db push --dry-run",
    "supabase:db:pull": "npx supabase db pull",
    "supabase:types": "npx supabase gen types typescript --linked --schema public > src/types/supabase.generated.ts",
    "media:upload": "node scripts/upload-remote-media.js",
    "media:batch:catalog": "node scripts/catalog-photo-batch.mjs",
    "media:batch:analyze": "node scripts/analyze-photo-batch.mjs",
    "media:batch:faces": "node scripts/face-enrich-photo-batch.mjs",
    "media:batch:faces:digikam": "node scripts/import-digikam-face-metadata.mjs",
    "media:batch:organize": "node scripts/organize-photo-batch.mjs",
    "media:batch:optimize": "node scripts/optimize-photo-batch.mjs",
    "media:batch:export": "node scripts/export-photo-import-manifest.mjs",
    "media:batch:publish": "node scripts/publish-photo-batch.mjs",
    "media:batch:albums:backfill": "node scripts/backfill-photo-albums.mjs",
    "media:batch:review:push": "node scripts/push-photo-review-batch.mjs",
    "media:review:reset": "node scripts/reset-media-review-queue.mjs",
    "media:batch:evaluate": "node scripts/evaluate-photo-batch.mjs",
    "media:batch:prepare": "node scripts/prepare-photo-batch.mjs",
    "media:guest:tag:export": "node scripts/export-approved-guest-photos-for-digikam.mjs",
    "media:guest:review:push": "node scripts/push-guest-photo-review-batch.mjs",
    "media:guest:tag:sync": "node scripts/sync-guest-photo-face-metadata.mjs",
    "inspect:guestbook": "node scripts/inspect_guestbook.cjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test tests/e2e/home.spec.ts tests/e2e/film.spec.ts tests/e2e/gallery.spec.ts tests/e2e/upload.spec.ts tests/e2e/guestbook.spec.ts tests/e2e/a11y.spec.ts tests/e2e/shell.spec.ts tests/e2e/smoke.spec.ts tests/e2e/seo.spec.ts",
    "test:e2e:admin": "playwright test tests/e2e/admin-auth.spec.ts tests/e2e/admin-shell.spec.ts tests/e2e/admin-a11y.spec.ts tests/e2e/admin-workflows.spec.ts tests/e2e/admin-visuals.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:visual": "playwright test --config playwright.config.visual.ts",
    "test:visual:update": "playwright test --config playwright.config.visual.ts --update-snapshots",
    "test:visual:ui": "playwright test --config playwright.config.visual.ts --ui",
    "test:live:images": "playwright test tests/e2e-live/image-audit.spec.ts --config playwright.config.visual.ts",
    "perf": "npm run build && node scripts/run-lhci.js",
    "verify:env": "node scripts/verify-release-env.js",
    "verify:launch": "npm run verify:release && node scripts/verify-launch-readiness.js",
    "verify:deployed": "node scripts/verify-deployed-site.js",
    "verify:admin:live": "node scripts/verify-live-admin-smoke.js",
    "verify:secrets": "node scripts/verify-repo-secrets.js",
    "verify:supabase": "node scripts/verify_supabase.js",
    "verify:release": "npm run verify:env && npm run verify:secrets && npm run verify:supabase && npm run lint && npx tsc --noEmit && npm run test:run && npm run build && npm run test:e2e:public",
    "deps:update": "node scripts/update-dependencies.cjs",
    "deps:check": "npm outdated && npm audit",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix --legacy-peer-deps"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/allura": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@sentry/browser": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "blurhash": "^2.0.5",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.13",
    "framer-motion": "12.43.0",
    "jszip": "^3.10.1",
    "lenis": "1.3.25",
    "lucide-react": "0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-masonry-css": "^1.0.16",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "^4.3.2",
    "web-vitals": "^5.1.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@aws-sdk/lib-storage": "^3.1101.0",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.2.0",
    "@types/jszip": "^3.4.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "25.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.9",
    "@vladmandic/human": "^3.3.6",
    "csso": "^5.0.5",
    "dotenv": "17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "exifr": "^7.1.3",
    "globals": "17.8.0",
    "husky": "^9.1.7",
    "jsdom": "28.1.0",
    "lint-staged": "16.3.2",
    "prettier": "3.9.6",
    "rollup-plugin-visualizer": "7.0.1",
    "serve": "14.2.6",
    "sharp": "^0.35.3",
    "sitemap": "9.0.1",
    "supabase": "^2.111.0",
    "terser": "5.49.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.9",
    "wait-on": "9.1.0"
  },
  "overrides": {
    "@rollup/plugin-terser": "1.0.0",
    "@lhci/utils": {
      "js-yaml": "^4.1.1"
    },
    "serialize-javascript": "7.0.5",
    "axios": ">=1.15.0",
    "tmp": ">=0.2.4",
    "uuid": ">=11.1.1"
  }
}
