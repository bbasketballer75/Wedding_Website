# Deliberate use of --legacy-peer-deps for the eslint 10 family.
#
# eslint-plugin-jsx-a11y@6.10.2 (current latest) declares a peer dep of
# ^3||^4||^5||^6||^7||^8||^9 — refusing to install against eslint 10.
# The plugin works correctly against eslint 10 at runtime; the peer
# range is an upstream manifest lag. See PR #120 commit message for
# the full rationale. When eslint-plugin-jsx-a11y releases a version
# with ^10 in its peer dep, this can be removed.
#
# Applying via .npmrc means this policy applies to all installs
# (npm ci in CI, npm install for local agents and developers).
legacy-peer-deps=true
