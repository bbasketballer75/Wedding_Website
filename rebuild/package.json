{
  "name": "theporadas-rebuild",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:ts6": "tsc6 --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:seo": "node scripts/generate-sitemap.mjs && node scripts/prerender.mjs && node scripts/check-deploy-assets.mjs",
    "build:seo:check": "node scripts/generate-sitemap.mjs --check && node scripts/prerender.mjs --check",
    "build:prod": "vite build && npm run build:seo",
    "perf:budgets": "node scripts/check-budgets.mjs",
    "perf:budgets:ci": "node scripts/check-budgets.mjs --mode baseline --json --report-json perf/last-budget-report.json",
    "media:plan": "node scripts/media-optimize.mjs --plan",
    "media:check": "node scripts/media-optimize.mjs --check",
    "media:generate": "node scripts/media-optimize.mjs --generate",
    "test:contract": "node scripts/run-contract-test.mjs",
    "cutover:check": "node ../tools/cutover/check-forward-migrations.mjs",
    "cutover:verify": "node ../tools/cutover/apply-forward-migrations.mjs --dry-run"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/pinyon-script": "5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "^14.10.1",
    "lucide-react": "^1.47.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^17.0.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
