# Public browser values only. Never put a service-role key in a VITE_* variable.
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key

# Canonical origin used by the metadata helpers (defaults to production).
VITE_SITE_URL=https://www.theporadas.com

