# Deliberate use of --legacy-peer-deps for the eslint 10 / typescript-eslint 8.73
# family.
#
# @typescript-eslint/typescript-estree@8.73.0 adds an OPTIONAL peer on
# @typescript/native with the range
#   npm:typescript@>=7.1.0-dev.20261009.1 || >=7.1.0-beta <7.1.0-dev
# The project pins @typescript/native to npm:typescript@7.0.2, which does not
# satisfy that range. npm 11 (the version pinned in packageManager and used by
# Netlify) records the optional peer and installs fine; npm 10 — the version
# that `actions/setup-node@v7` with node-version '22' provides — resolves the
# optional peer to a different @typescript/native and then fails `npm ci` with
#   npm error code EUSAGE ... Missing: @typescript/native@7.1.0-dev... from lock file
#
# The peer is OPTIONAL and the app never reads it: the rebuild's `tsc` binary
# comes from the pinned @typescript/native (7.0.2) and the lint stack works
# against it at runtime. This is the same upstream manifest lag the repo root
# already records for eslint-plugin-jsx-a11y vs eslint 10 (see ../../.npmrc).
#
# Applying via .npmrc means this policy applies to all installs (npm ci in CI,
# npm install for local agents and developers) and keeps the lockfile installable
# by both npm 10 and npm 11.
legacy-peer-deps=true
