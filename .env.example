# ============================================
# Environment Variables Example
# Copy this file to .env and fill in your values
# ============================================

# Supabase Configuration
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: CDN or Supabase Storage base URL for large public media assets
# Leave unset to serve media from the local /public directory.
# Example: https://your-project.supabase.co/storage/v1/object/public/wedding-media
# VITE_MEDIA_BASE_URL=

# Required before public launch: canonical site origin for SEO/share metadata and sitemap generation.
# Use the private staging origin until launch day, then switch to the final custom domain.
# Example staging: https://austin-jordyn-wedding.netlify.app
# Example launch: https://wedding.theporadas.com
# VITE_SITE_URL=

# ============================================
# Optional: Analytics & Monitoring
# ============================================

# Google Analytics (required before public launch if launch readiness depends on GA verification)
# VITE_GA_ID=G-XXXXXXXXXX

# Sentry for error tracking (required before public launch if monitoring is mandatory)
# VITE_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

# Recommended before launch: override the release label sent to monitoring tools.
# Example: 2026-03-11-launch. When unset, the app falls back to the package version at build time.
# VITE_APP_VERSION=1.0.0

# ============================================
# Feature Flags (optional)
# ============================================

# Enable/disable guest uploads
# VITE_ENABLE_UPLOADS=true

# Enable/disable guestbook
# VITE_ENABLE_GUESTBOOK=true

# Require approval for uploads
# VITE_REQUIRE_UPLOAD_APPROVAL=true
