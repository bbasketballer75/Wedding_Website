# ============================================
# Environment Variables Example
# Copy this file to .env and fill in your values
# ============================================

# Supabase Configuration
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: CDN or Supabase Storage base URL for large public media assets
# Leave unset to serve media from the local /public directory.
# Example: https://media.your-domain.com
# VITE_MEDIA_BASE_URL=

# Required before public launch: canonical site origin for SEO/share metadata and sitemap generation.
# Use the private staging origin until launch day, then switch to the final custom domain.
# Example staging: https://austin-jordyn-wedding.netlify.app
# Example launch: https://www.theporadas.com
# VITE_SITE_URL=

# ============================================
# Optional: Analytics & Monitoring
# ============================================

# Google Analytics (required before public launch if launch readiness depends on GA verification)
# VITE_GA_ID=G-XXXXXXXXXX

# Sentry for error tracking (required before public launch if monitoring is mandatory)
# The DSN host must also be allowlisted in `connect-src` in public/_headers, or the
# browser blocks every event and Sentry stays empty. src/__tests__/sentryCspHeaders.test.ts
# enforces that.
# VITE_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

# Build-only credentials for uploading source maps for each release. Set these in
# Netlify (Site configuration → Environment variables) for the Production scope.
# When all three are present the build emits hidden source maps, uploads them under
# the release below, and deletes them from dist. When absent, no maps are emitted.
# Set ALL THREE or NONE: a partial set fails the build on purpose, because a
# half-configured environment would otherwise ship an unsymbolicated deploy
# without saying so. An unset, empty, or whitespace-only value counts as absent to
# both `npm run verify:env` and the build, so blank variables can never enable an
# upload with empty credentials.
# In a Netlify deploy (production, deploy-preview, branch-deploy) an enabled upload
# also requires COMMIT_REF, which Netlify sets automatically: the release must be
# unique per deploy or the uploaded maps cannot be matched to the deployed commit.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=friendly-city-t9
# SENTRY_PROJECT=theporadas-com

# Optional release label. Production deploys derive the release from the Netlify
# deploy commit (`COMMIT_REF`) so each deploy gets a distinct release that can be
# matched to its uploaded source maps. This value is only used when no commit ref
# is available (local builds), falling back to the package version after that. A
# whitespace-only value is ignored.
# VITE_APP_VERSION=1.0.0

# Optional local-only live admin smoke check.
# Keep these only in ignored local env files; never commit real admin credentials.
# ADMIN_SMOKE_EMAIL=
# ADMIN_SMOKE_PASSWORD=

# ============================================
# Cloudflare R2 Media Storage (required for Netlify upload function and upload script)
# Create at: Cloudflare Dashboard → R2 → Manage API Tokens
# ============================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=wedding-media
# Public base URL (custom domain attached to R2 bucket)
R2_PUBLIC_BASE_URL=https://media.wedding.theporadas.com

# ============================================
# Feature Flags (optional)
# ============================================

# Enable/disable guest uploads
# VITE_ENABLE_UPLOADS=true

# Enable/disable guestbook
# VITE_ENABLE_GUESTBOOK=true

# Require approval for uploads
# VITE_REQUIRE_UPLOAD_APPROVAL=true
